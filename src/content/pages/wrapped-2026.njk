        .intro-stats-preview {
          grid-template-columns: 1fr;
          gap: 0.75rem;
        }
      }

      /* Top Navigation & Progress Bar (directly under global header) */
      .quiz-top-nav {
        position: sticky;
        top: 0;
        background: var(--nys-color-surface, #ffffff);
