        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--nys-space-200, 16px);
      }

      .quiz-nav-actions {
        display: flex;
        align-items: center;
        gap: var(--nys-space-100, 8px);
      }

      .quiz-progress-group {
        display: flex;
        align-items: center;
        gap: var(--nys-space-150, 12px);
        flex: 1;
        max-width: 440px;
      }

      .quiz-progress-group progress {
        width: 100%;
        height: var(--nys-space-100, 8px);
        appearance: none;
        border: none;
        border-radius: var(--nys-radius-round, 999px);
        overflow: hidden;
        background: var(--nys-color-base-weak, #d6d7d9);
      }

      .quiz-progress-group progress::-webkit-progress-bar {
        background: var(--nys-color-base-weak, #d6d7d9);
        border-radius: var(--nys-radius-round, 999px);
      }

      .quiz-progress-group progress::-webkit-progress-value {
        background: var(--nys-color-theme, #154973);
        border-radius: var(--nys-radius-round, 999px);
        transition: width 240ms ease;
      }

      .quiz-progress-group progress::-moz-progress-bar {
        background: var(--nys-color-theme, #154973);
        border-radius: var(--nys-radius-round, 999px);
      }

      .quiz-progress-text {
        font-size: var(--nys-font-size-ui-sm, 14px);
        color: var(--nys-color-text, #1b1b1b);
        font-weight: 600;
        white-space: nowrap;
