        subheading="Copy your result to share on Teams, Slack, or social.">
        <nys-textinput id="shareText" label="Share Text" type="text" readonly></nys-textinput>
        <div slot="actions">
          <nys-button id="copyShareBtn" label="Copy Text" variant="primary"></nys-button>
          <nys-button id="closeShareBtn" label="Close" variant="outline"></nys-button>
