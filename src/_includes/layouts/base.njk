<!DOCTYPE html>
<html lang="en">
  <head>
    {% include "partials/head-meta.njk" %}
    {% block styles %}{% endblock %}
    <!-- Latest Build: {{ site.buildDate | dateISO }} -->
  </head>
  {% set currentPageUrl = page.url %}
  <body class="{% if section  %}single-page page-{{ page.fileSlug }} section-{{section | slug}}{% else %}home{% endif %}{% if heading_links == false %} no-heading-links{% endif %}">
  <nys-skipnav></nys-skipnav>
  {% include "partials/unav-header.njk" %}
  {% include "partials/site-header.njk" %}

  <main role="main" id="main-content" data-pagefind-body>
  
      {% block content %}
      {{ content | safe }}
      {% endblock %}
  </main>
  <nys-backtotop id="backtotop-demo"></nys-backtotop>
  
  {% include "partials/site-footer.njk" %}
  {% include "partials/unav-footer.njk" %}

  <!-- Quick Search Dialog -->
  <nys-modal id="search-dialog" heading="Search">
    {#- nys-padding-2px keeps the input's focus outline inside the modal body's scroll area -#}
    <div class="search-dialog nys-display-flex nys-flex-column nys-padding-2px">
      <nys-textinput
        id="search-dialog-input"
        type="search"
        ariaLabel="Search the design system"
        placeholder="Search…"
      >
        <nys-button id="search-dialog-submit" slot="endButton" prefixIcon="search">
          <span class="sr-only">See all results</span>
        </nys-button>
      </nys-textinput>
      <ul id="search-dialog-results" role="listbox" aria-label="Search results" class="search-dialog__results" hidden></ul>
      <p id="search-dialog-status" class="search-dialog__status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </nys-modal>

  {% include "partials/site-js-global.njk" %}
  {% block scripts %}{% endblock %}
  </body>
</html>
