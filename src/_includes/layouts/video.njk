{% extends "layouts/base.njk" %}

{% block content %}

{% set previousVideo = collections.videoPageCollection | getPreviousCollectionItem(page) %}
{% set nextVideo = collections.videoPageCollection | getNextCollectionItem(page) %}

<div class="nys-grid-container-widescreen">
  <div class="nys-grid-row nys-grid-gap">
    <aside class="nys-tablet:nys-grid-col-3">
      {% include "partials/section-nav.njk" %}
    </aside>
    <main class="nys-tablet:nys-grid-col-9">

      <section class="page-content">
        {%- if video_url -%}
        <div class="video-embed">
          <nys-video size="full" videourl="https://www.youtube.com/watch?v={{ video_url}}"></nys-video>
        </div>
        {%- endif -%}

        <h1 class="page-title">{{ title }}</h1>

        {%- include "partials/taglist.njk" -%}

        {{ content | safe }}

      </section>

      <section class="page-meta nys-grid-row nys-grid-gap-600">
        {% if previousVideo %}
        <a href="{{ previousVideo.url }}" class="nys-tablet:nys-grid-col">
            Previous Video: <strong>{{ previousVideo.data.title }}</strong>
        </a>
        {% endif %}
        {% if nextVideo %}
        <a href="{{ nextVideo.url }}" class="nys-tablet:nys-grid-col">
            Next Video: <strong>{{ nextVideo.data.title }}</strong>
        </a>
        {% endif %}
      </section>
      {% include "partials/edit-link.njk" %}
    </main>

  </div>
</div>

{% endblock %}
