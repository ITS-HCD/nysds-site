{% extends "layouts/base.njk" %}

{% block content %}
<div class="nys-grid-container-widescreen">
<div class="nys-grid-row nys-grid-gap">
  <aside class="nys-desktop:nys-grid-col-auto nys-order-first">
    {% include "partials/section-nav.njk" %}
  </aside>
  <div class="nys-desktop:nys-grid-col-fill nys-order-1 nys-desktop:nys-order-0">  
    {{ content | safe }}
    {% include "partials/edit-link.njk" %}
  </div>
  <aside class="nys-desktop:nys-grid-col-2 nys-order-0 nys-desktop:nys-order-1">
    {% include "partials/onpage-nav.njk" %}
  </aside>
</div>
</div>

{% endblock %}